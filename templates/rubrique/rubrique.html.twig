{% extends 'base.html.twig' %}

{% block title %}Hello RubriqueController!{% endblock %}

{% block body %}
<h3 style="text-align: center">Nos Produits
		<h3>

			<div class="row">
				{% for sousrubrique in sousrubrique %}
				<div class="column">
					<div class="card">
						<img src="{{ asset("/img/" ~ sousrubrique.image)}}" alt="image introuvable" class="card-img" style="width:100%">
						<div class="container">
							<h2>{{sousrubrique.libelle}}</h2>
							<p class="card-title">{{sousrubrique.nom}}</p>
								<button class="button-card" ><a href="/sousrubrique?srid={{sousrubrique.id}}" class="btn-lien textbtn">Consulter</a></button>
							</p>
						</div>
					</div>
				</div>
				{% endfor %}
{% endblock %}
