{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}
	<br> 

	<!-- Slideshow container -->
	<div
		class="slideshow-container">

		<!-- Full-width images with number and caption text -->
		<div class="mySlides">
			<div class="numbertext">1 / 3</div>
			<img class="img-band" src='{{ asset("/img/GuitareClassique5.png")}}'>
			<div class="text">Caption Text</div>
		</div>

		<div class="mySlides">
			<div class="numbertext">2 / 3</div>
			<img class="img-band" src='{{ asset("/img/piano.jpeg")}}'>
			<div class="text">Caption Two</div>
		</div>

		<div class="mySlides">
			<div class="numbertext">3 / 3</div>
			<img class="img-band" src='{{ asset("/img/batterie.jpg")}}'>
			<div class="text">Caption Three</div>
		</div>

		<!-- Next and previous buttons -->
		<a class="prev" id="prev">&#10094;</a>
		<a class="next" id="next">&#10095;</a>
	</div>
	<br>

	<!-- The dots/circles -->
	<div style="text-align:center">
		<span class="dot" onclick="window.currentSlide(1)"></span>
		<span class="dot" onclick="window.currentSlide(2)"></span>
		<span class="dot" onclick="window.currentSlide(3)"></span>
	</div>

	<br>
	<h3 style="text-align: center">Nos Produits
		<h3>

			<div class="row" style="margin:auto">
				{% for produit in produit %}
				<div class="column">
					<div class="card">
						<img src="{{ asset("/img/" ~ produit.photo)}}" alt="produit" class="card-img" style="width:100%">
						<div class="container">
							<h2>{{produit.libelle}}</h2>
							<p class="card-title">{{produit.sousrubrique.nom}}</p>
							<p class="card-desc">{{produit.description}}</p>
							<p>{{produit.prix}} €</p>
							<p>
								<button class="button-card">Commander</button>
							</p>
						</div>
					</div>
				</div>
				{% endfor %}

      </div>

			{% endblock %}
