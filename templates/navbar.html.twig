<header class="velours">
	<div class="container-fluid">
		<nav class="navbar navbar-expand-sm row ">
			<ul class="navbar-nav float-right">
				<li>
					<h1 style="color:green">village green</h1>
					<div class="search me-auto">{{form_start(searchform)}}  {{form_end(searchform)}}</div>
					 {# <i class="fa fa-search"></i> #}
				</li>
				<div class="topnav-right">
					<li>
						<button class="btn">
							<a href='/accueil'>Accueil</a>
						</button>
					</li>
					<li>
						<div class="nav-item">
							<button class="btn">
								<a href="{{ path('app_user_crud_index') }}">Mon compte</a>
							</button>
							<div class="dropdown">
								{% if app.user %}
									<button class="btn">
										<i class="fa fa-caret-down"></i>
									</button>
									<div class="dropdown-content">
										<a href="/logout">se deconnecter</a>
										<a href="/register">s'inscrire</a>
									</div>
								{% else %}
									<button class="btn">
										<i class="fa fa-caret-down"></i>
									</button>
									<div class="dropdown-content">
										<a href="/login">se connecter</a>
										<a href="/register">s'inscrire</a>
									</div>
								{% endif %}
							</div>
						</div>
					</li>
				</div>

			</ul>
		</nav>
	</div>

</header>

<nav class="navbar navbar-expand-sm row " style="background-color: #16161d">

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse justify-content-center" id="collapsibleNavbar">
			<ul class="navbar-nav ">
				{% for rubrique in rubriques %}
					<li class="nav-item">
						<button class="btn">
							<a href='/rubrique?rid={{rubrique.id}}'>{{rubrique.nom}}</a>
						</button>
						<div class="dropdown">
							<button class="btn">
								<i class="fa fa-caret-down"></i>
							</button>
							<div class="dropdown-content">
								{% for sousRubrique in rubrique.sousRubriques %}
									<a href="/sousrubrique?srid={{sousRubrique.id}}">{{ sousRubrique.nom}}</a>
								{% endfor %}
							</div>
						</div>
					</li>
				{% endfor %}
			</ul>
		</div>
	</nav>