<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Base
			{% endblock %}
			Village Green</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">


		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet"> 
		{% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>

	<body class="corps">

		<header class="velours">
			<div class="container-fluid">
				<div class="row">
					<h1>village green</h1>

					<div class="search me-auto">{{search|raw}}</div>
				</div>
			</div>
		</header>

		<nav class="navbar navbar-expand-sm row">

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="collapsibleNavbar">
				<ul class="navbar-nav ">
					<li class="nav-item">
						<button class="btn-accueil" style="margin-left:1rem" ><a href='/'>Accueil</button>
						{# <div class="dropdown">
							<button class="btn">
								<i class="fa fa-caret-down"></i>
							</button>
							<div class="dropdown-content">
								<a href="#">Link1</a>
								<a href="#">Link2</a>
							</div>
						</div> #}
					</li>
					{% for rubrique in rubriques %}
					<li class="nav-item">
						<button class="btn">
						<a href='/rubrique?rid={{rubrique.id}}'>{{rubrique.nom}} </a></button>
						<div class="dropdown">
							<button class="btn">
								<i class="fa fa-caret-down"></i>
							</button>
							<div class="dropdown-content">
							{% for sousRubrique in rubrique.sousRubriques %}
								<a href="/sousrubrique?srid={{sousRubrique.id}}">{{ sousRubrique.nom}}</a>
							{% endfor %}
							</div>
						</div>
					</li>
					{% endfor %}
					
					<li class="nav-item">
						<button class="btn">Mon compte</button>
						<div class="dropdown">
							<button class="btn">
								<i class="fa fa-caret-down"></i>
							</button>
							<div class="dropdown-content">
								<a href="#">Link1</a>
								<a href="#">Link2</a>
							</div>
						</div>
					</li> 
				</ul>
			</div>

		</nav>


		{% block body %}{% endblock %}
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>

	</body>
</html>
