{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>User</h1>

    <table class="table">
    {% for user in users %}
        <tbody>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ user.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ user.prenom }}</td> 
            </tr>
            {% if user.roles == ('ROLE_PRO') %}
            <tr>
                <th>Siret</th>
                <td>{{ user.siret }}</td>
            </tr>
            <tr>
                <th>Id_pro</th>
                <td>{{ user.idPro }}</td>
            </tr>
            {% endif %}
            <tr>
                <th> <h3>Adresse de facturation</h3> </th>
            <tr>
            <tr>
                <th>Adresse_livraison</th>
                <td>{{ user.adresseLivraison }}</td>
            </tr>
            <tr>
                <th>Ville_livraison</th>
                <td>{{ user.villeLivraison }}</td>
            </tr>
            <tr>
                <th>Code_postal_livraison</th>
                <td>{{ user.codePostalLivraison }}</td>
            </tr>
            <tr>
                <th> <h3>Adresse de facturation</h3> </th>
            <tr>
                <th>Ville_facturation</th>
                <td>{{ user.villeFacturation }}</td>
            </tr>
            <tr>
                <th>Adresse_facturation</th>
                <td>{{ user.adresseFacturation }}</td>
            </tr>
            <tr>
                <th>Code_postal_facturation</th>
                <td>{{ user.codePostalFacturation }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_crud_index') }}">back to list</a>

    <a href="{{ path('app_user_crud_edit', {'id': user.id}) }}">edit</a>

    {{ include('user_crud/_delete_form.html.twig') }}
{% endblock %}
