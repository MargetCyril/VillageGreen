{% extends 'base.html.twig' %}

{% block title %}Hello PanierController!{% endblock %}

{% block body %}
    <main class ="container">
        <section class="row">
            <div class="col-12">
                <h1>Panier</h1>
                    <table class="table">
                        <thead>
                            <tr>
                                <th> Produit </th>
                                <th> Prix </th>
                                <th> Quantité </th>  
                                <th> total </th>
                                <th> action </th> 
                            </tr>
                        </thead>
                        <tbody>
                            {% for element in data %}
                                <tr>
                                    <td>{{ element.produit.libelle }}</td>
                                    <td>{{element.produit.prix }} €</td>
                                    <td>{{element.quantite}}</td>
                                    <td>{{element.quantite * element.produit.prix}} €</td>
                                    <td>   
                                        <a href="{{ path('app_panier_add', {id: element.produit.id}) }}" class="btn btn-success">+</a>
                                        <a href="{{ path('app_panier_remove', {id: element.produit.id}) }}" class="btn btn-warning">-</a>
                                        <a href="{{ path('app_panier_delete', {id: element.produit.id}) }}" class="btn btn-danger">Supprimer</a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5">Votre panier est vide</td>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3"> Total</td>
                                <td> {{total}} €</td>
                                <td>
                                <a href="{{ path('app_panier_empty')}}" class="btn btn-danger">Vider</a>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <a href="{{ path('app_commande_add') }}" class="btn btn-primary">Valider</a>
            </div>
        </section>
    </main>
{% endblock %}
